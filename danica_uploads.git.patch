new file mode 100644
index 0000000..459f0d1
--- /dev/null
+++ b/danica/tui/commands_sessions.py
@@ -0,0 +1,73 @@
+"""
+/sessions delete - remove saved sessions (the list itself is still /sessions, see commands.py).
+
+    /sessions delete 3          row 3 of /sessions        /sessions delete 2-5       rows 2 to 5
+    /sessions delete 20261102-013000    an id or a unique start of one
+    /sessions delete empty      sessions with no requests  /sessions delete all       every session except this one
+
+It asks first (starting on "No") and shows what goes: id, date, title, requests and size. A chat session's own
+workspace goes with it. A PROJECT session never deletes the project folder: only Danica's saved conversation of it.
+The current session cannot be deleted (use /new first).
+"""
+
+from danica import sessions
+from danica.tui.commands import COMMANDS, DESCRIPTIONS
+
+_list_sessions = COMMANDS["/sessions"]              # the original handler still shows the list
+
+
+def _human(n: int) -> str:
+    from danica.uploads import human
+    return human(n)
+
+
+def _delete(app, words: list[str]) -> None:
+    if not words:
+        app.ui.log("info", "usage: /sessions delete <number | 2-5 | id | empty | all>   (see /sessions for the numbers)")
+        return
+    root = sessions.SESSIONS_DIR
+    ids, problems = sessions.select_sessions(root, words, current=app.session_id)
+    for p in problems:
+        app.ui.log("error", p)
+    if not ids:
+        if not problems:
+            app.ui.log("info", "nothing to delete")
+        return
+    infos = [sessions.describe_session(root, sid) for sid in ids]
+    lines = []
+    for i in infos[:12]:
+        when = f"{i['modified']:%d %b %H:%M}" if i["modified"] else "no transcript"
+        where = "project (its folder is NOT touched)" if i["project"] else ("chat (its workspace files go too)" if i["has_files"] else "chat")
+        lines.append(f"{i['id']}  {when}  {i['requests']} request(s)  {_human(i['size'])}  {where}\n    {i['title'] or '(untitled)'}")
+    if len(infos) > 12:
+        lines.append(f"... and {len(infos) - 12} more")
+    total = sum(i["size"] for i in infos)
+    body = "\n".join(lines)
+    if not app.ui.confirm(f"Delete {len(infos)} session(s)?", body, f"{_human(total)} will be freed. This cannot be undone.",
+                          yes="Yes, delete", no="No, keep them"):
+        app.ui.log("info", "nothing deleted")
+        return
+    gone, failed = [], []
+    for sid in ids:
+        try:
+            (gone if sessions.delete_session(root, sid) else failed).append(sid)
+        except (ValueError, OSError) as exc:
+            failed.append(sid)
+            app.ui.log("error", f"{sid}: {exc}")
+    if gone:
+        app.ui.log("info", f"deleted {len(gone)} session(s), freed about {_human(total)}")
+        app.audit.append("sessions_deleted", ids=gone)
+    if failed:
+        app.ui.log("error", f"could not fully delete: {', '.join(failed)} (a file may be open in another program)")
+
+
+def _sessions(app, args):
+    words = args.split()
+    if words and words[0].lower() in ("delete", "rm", "remove"):
+        _delete(app, words[1:])
+    else:
+        _list_sessions(app, args)
+
+
+COMMANDS["/sessions"] = _sessions
+DESCRIPTIONS["/sessions"] = "list saved sessions; /sessions delete <n|2-5|id|empty|all> removes them"
diff --git a/danica/tui/commands_upload.py b/danica/tui/commands_upload.py
new file mode 100644
index 0000000..456ddff
--- /dev/null
+++ b/danica/tui/commands_upload.py
@@ -0,0 +1,63 @@
+"""
+commands_upload.py - /upload: put your files into Danica's workspace.
+
+    /upload                    opens the file dialog (pick one or several files)
+    /upload <path> [<path>..]  copies those files (quotes are fine, drag a file into the terminal to paste its path)
+
+Files go to <workspace>/uploads/. A .zip is unzipped into its own folder there (safely, see uploads.py).
+Your originals are never changed. Danica is told about the new files with your next message.
+(/attach does the same for a picture and also shows it to her right away.)
+
+Imported at the bottom of commands.py, like commands_vision.py.
+"""
+
+import re
+from pathlib import Path
+
+from danica import uploads
+from danica.tui.commands import DESCRIPTIONS, command
+
+DESCRIPTIONS["/upload"] = "put files (or a .zip) into the workspace"
+
+
+def parse_paths(text: str) -> list[str]:
+    """Paths from what was typed: "C:\\my folder\\a.pdf" 'b.txt' c.zip  (quotes keep spaces; backslashes stay as typed)."""
+    return [a or b or c for a, b, c in re.findall(r'"([^"]+)"|\'([^\']+)\'|(\S+)', text)]
+
+
+@command("/upload")
+def _upload(app, args):
+    """/upload [path ...]   copies files into the workspace uploads/ folder; a .zip is unzipped."""
+    names = parse_paths(args)
+    try:
+        if not names:
+            app.ui.log("info", "opening the file dialog (it may open behind this window)...")
+            names = [str(p) for p in uploads.pick_files()]
+            if not names:
+                app.ui.log("info", "cancelled: no file chosen.")
+                return
+    except uploads.UploadError as e:
+        app.ui.log("error", str(e))
+        return
+    stored = []
+    for name in names:
+        path = Path(name).expanduser()
+        if not path.is_absolute():
+            path = app.ws.root / path                                   # relative paths start at the workspace
+        try:
+            item = uploads.store_file(app.ws.root, path)
+        except uploads.UploadError as e:
+            hint = "  (a path with spaces needs quotes)" if " " not in name and not path.exists() and len(names) > 1 else ""
+            app.ui.log("error", f"{path.name}: {e}{hint}")
+            continue
+        stored.append(item)
+        app.ui.log("ok", uploads.describe(item))
+        if item.kind == "folder":
+            app.ui.log("info", "  top level: " + ", ".join(item.sample))
+        for note in item.notes:
+            app.ui.log("warning", "  " + note)
+    if not stored:
+        return
+    app.agent.upload_notes.append(uploads.model_note(stored))          # the model hears about them with the next request
+    app.audit.append("upload", files=[s.rel for s in stored], bytes=sum(s.size for s in stored))
+    app.ui.log("info", "Danica will know about these files with your next message.")
