Screen {
    layout: vertical;
    background: ansi_default;
    color: #d8deeb;
}

/* ---- transcript ---- */
#transcript {
    height: 1fr;
    padding: 1 2;
    background: transparent;
    scrollbar-size-vertical: 1;
    scrollbar-color: #5e5e5e;
    scrollbar-background: #353535;
    scrollbar-color-hover: #5e5e5e;
    scrollbar-color-active: #5a5a5a;
}

.welcome { margin: 1 0 0 0; }
.user { margin: 1 0 0 0; padding: 0 1; color: #e6eaf2; background: #171b26; border-left: heavy #7aa2f7; }
.notice { margin: 1 0 0 0; }
.say { margin: 1 0 0 0; }
.citations { margin: 1 0 0 0; }
.artifacts { margin: 1 0 0 0; }
.thinking { margin: 1 0 0 0; padding: 0 1; color: #9aa4bf; }
.toolcall { margin: 1 0 0 0; padding: 0 1; background: transparent; border-left: round #39445f; }

AssistantMessage {
    margin: 1 0 0 0;
    padding: 0;
    background: transparent;
}

/* ---- prompt box ---- */
#busy {
    height: 1;
    padding: 0 3;
}

#prompt-box {
    height: auto;
    margin: 0 1;
    padding: 0 1;
    border: round #39445f;
    background: transparent;
}

#caret {
    width: 2;
    color: #7aa2f7;
    text-style: bold;
}

#prompt {
    height: auto;
    min-height: 1;
    max-height: 8;
    padding: 0;
    border: none;
    background: transparent;
    scrollbar-size-vertical: 1;
    scrollbar-color: #5e5e5e;
    scrollbar-background: #353535;
    scrollbar-color-hover: #5e5e5e;
    scrollbar-color-active: #5a5a5a;
}

#prompt:focus {
    border: none;
    background: transparent;
}

#prompt .text-area--cursor-line { background: transparent; }

#popup {
    display: none;
    height: auto;
    max-height: 10;
    margin: 0 1;
    padding: 0;
    background: transparent;
    border: round #39445f;
    outline: none;
    scrollbar-size-vertical: 1;
    scrollbar-color: #5e5e5e;
    scrollbar-background: #353535;
    scrollbar-color-hover: #5e5e5e;
    scrollbar-color-active: #5a5a5a;
}

#popup > .option-list--option-highlighted { background: #343d54; }

#caret { height: 1; }

#status {
    height: 2;
    padding: 0 2;
    color: #a9b4c8;
    background: transparent;
    border-top: solid #2b3040;
}

/* ---- dialogs ---- */
PermissionScreen, ConfirmScreen, ChoiceScreen, TextScreen {
    align: center middle;
    background: black 60%;
}

.dialog {
    width: 80%;
    min-width: 0;
    max-width: 96;
    height: auto;
    max-height: 90%;           /* was 50%: it clipped the bottom of tall dialogs */
    padding: 1 2;
    background: transparent;
    border: round #39445f;
}

.dialog.warn { border: round #e0af68; }

.dialog-title { text-style: bold; margin-bottom: 1; }
.dialog-reason { margin-bottom: 1; }

.dialog-body {
    height: auto;
    max-height: 12;            /* was 18: keeps the buttons on screen on short terminals */
    margin-bottom: 1;
    background: transparent;
    padding: 0 1;
    overflow-y: auto;          /* long commands scroll instead of pushing the buttons away */
}

.dialog-buttons { height: auto; }

.dialog-buttons Button {
    width: 1fr;                /* equal shares of the row, so every button fits */
    min-width: 0;
    margin-right: 2;
    background: transparent;
}

.dialog-buttons Button:last-of-type { margin-right: 0; }
.dialog-buttons Button:focus { background: transparent; text-style: bold; }

/* ---- split screen: chat | subagent pane ---- */
#main { height: 1fr; }

#agents-pane {
    width: 45%;                 /* the chat keeps the other 55% */
    height: 100%;
    margin: 0 1 0 0;
    border: round #5c5c5c;
}

#sub-head { height: 1; padding: 0 1; }
#sub-log  { height: 1fr; padding: 0 1; background: transparent; scrollbar-size-vertical: 1; }
#sub-live { height: auto; max-height: 3; padding: 0 1; }

#agents-pane, #viewer-pane { border: round #39445f; background: transparent; }

