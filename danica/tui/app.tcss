Screen {
    layout: vertical;
    background: ansi_default;
    color: #f0f0f0;
}

/* ---- transcript ---- */
#transcript {
    height: 1fr;
    padding: 1 2;
    background: transparent;
    scrollbar-size-vertical: 1;
    scrollbar-color: #5e5e5e;
    scrollbar-background: #353535;
    scrollbar-color-hover: #5e5e5e;
    scrollbar-color-active: #5a5a5a;
}

.welcome { margin: 1 0 0 0; }
.user { margin: 1 0 0 0; padding: 0 1; color: #ffffff; background: #3e3e3e; border-left: heavy #ffffff; }
.notice { margin: 1 0 0 0; }
.say { margin: 1 0 0 0; }
.session-list {
    link-style: not underline;
    link-style-hover: not underline;
    link-color: #ffffff;
    link-color-hover: #000000;
    link-background: transparent;
    link-background-hover: #ffffff;
}
.citations { margin: 1 0 0 0; }
.termchart { margin: 0 0 0 2; height: auto; }
/* the file cards under a response: a heading, then a grid of small rectangles (name / type / size) */
.artifacts { margin: 1 0 0 0; height: auto; }
.art-heading { height: 1; }
.artgrid { layout: grid; grid-size: 2; grid-gutter: 0 1; height: auto; }
.artcard { height: auto; border: round #4a4a4a; padding: 0 1; background: transparent; border-title-color: #808080; border-subtitle-color: #808080; }
.artcard:hover { border: round #ffffff; background: transparent; }
.thinking { margin: 1 0 0 0; padding: 0 1; color: #b0b0b0; }
.toolcall { margin: 1 0 0 0; padding: 0; background: transparent; }   /* the box itself is drawn by Rich (widgets.ToolCall) */

AssistantMessage {
    margin: 1 0 0 0;
    padding: 0;
    background: transparent;
}

/* ---- prompt box ---- */
#busy {
    height: 1;
    padding: 0 3;
}

#prompt-box {
    height: auto;
    margin: 0 1;
    padding: 0 1;
    border: round #4a4a4a;
    background: transparent;
}

#caret {
    width: 2;
    color: #ffffff;
    text-style: bold;
}

#prompt {
    width: 1fr;
    height: auto;
    min-height: 1;
    max-height: 8;
    padding: 0;
    border: none;
    background: transparent;
    scrollbar-size-vertical: 1;
    scrollbar-color: #5e5e5e;
    scrollbar-background: #353535;
    scrollbar-color-hover: #5e5e5e;
    scrollbar-color-active: #5a5a5a;
}

#prompt:focus {
    border: none;
    background: transparent;
}

#prompt .text-area--cursor-line { background: transparent; }

#upload-button {
    width: auto;
    height: 1;
    margin-left: 1;
    background: transparent;
    color: #ffffff;
    link-color: #ffffff;
    link-color-hover: #000000;
    link-background: transparent;
    link-background-hover: #ffffff;
    link-style: not underline;
    link-style-hover: bold not underline;
}

#upload-button:hover {
    background: transparent;
}

#popup {
    display: none;
    height: auto;
    max-height: 10;
    margin: 0 1;
    padding: 0;
    background: transparent;
    border: round #4a4a4a;
    outline: none;
    scrollbar-size-vertical: 1;
    scrollbar-color: #5e5e5e;
    scrollbar-background: #353535;
    scrollbar-color-hover: #5e5e5e;
    scrollbar-color-active: #5a5a5a;
}

#popup > .option-list--option-highlighted { background: #333333; }

#caret { height: 1; }

#status {
    height: 2;
    padding: 0 2;
    color: #c0c0c0;
    background: transparent;
    border-top: solid #404040;
    /* the clickable chips: ctx, think/fast, permissions, TAINTED, plan next */
    link-color: #c0c0c0;
    link-style: not underline;
    link-color-hover: #000000;
    link-background: transparent;
    link-background-hover: #ffffff;
}

/* ---- dialogs ---- */
PermissionScreen, ConfirmScreen, ChoiceScreen, TextScreen {
    align: center middle;
    background: transparent;
}

.dialog {
    width: 80%;
    min-width: 0;
    max-width: 96;
    height: auto;
    max-height: 90%;           /* was 50%: it clipped the bottom of tall dialogs */
    padding: 1 2;
    background: transparent;
    border: round #4a4a4a;
}

.dialog.warn { border: round #d0d0d0; }

.dialog-title { text-style: bold; margin-bottom: 1; }
.dialog-reason { margin-bottom: 1; }

TextScreen #answer {
    width: 1fr;
    background: transparent;
    color: #f0f0f0;
    border: round #4a4a4a;
    padding: 0 1;
}

TextScreen #answer:focus {
    border: round #ffffff;
}

.dialog-body {
    height: auto;
    max-height: 12;            /* was 18: keeps the buttons on screen on short terminals */
    margin-bottom: 1;
    background: transparent;
    padding: 0 1;
    overflow-y: auto;          /* long commands scroll instead of pushing the buttons away */
}

.dialog-buttons { height: auto; }

.dialog-buttons Button {
    width: 1fr;                /* equal shares of the row, so every button fits */
    min-width: 0;
    margin-right: 2;
    background: transparent;
}

.dialog-buttons Button:last-of-type { margin-right: 0; }
.dialog-buttons Button:focus { background: transparent; text-style: bold; }

/* ---- buttons inside panels: ONE grayscale look for the manager panes (.mgr-actions), the confirm / permission / choice
   dialogs (.dialog-buttons) and the question form (.ask-buttons). Same states as the connection form:
   resting = grey outline, hover and focus = white and bold, press = brief fill, disabled = dim.
   Textual's own button style (a "tall" half-block border, a purple hover, a yellow focus ring, colour tints and the
   green / red variants) is switched off; !important is needed because those defaults are set per state and variant. */
.mgr-actions Button { margin-right: 1; min-width: 12; }                  /* layout of the manager's row of actions */

.mgr-actions Button,
.dialog-buttons Button,
.ask-buttons Button,
.cfg-buttons Button {
    height: 3;
    padding: 0 2;
    color: #c9c9c9 !important;
    background: transparent !important;
    background-tint: transparent !important;
    tint: transparent !important;
    border: round #808080 !important;                        /* "round" draws clean corners; the default "tall" leaves half-block marks */
    text-style: none !important;
}
.mgr-actions Button:hover,
.dialog-buttons Button:hover,
.ask-buttons Button:hover,
.cfg-buttons Button:hover,
.mgr-actions Button:focus,
.dialog-buttons Button:focus,
.ask-buttons Button:focus,
.cfg-buttons Button:focus {                                  /* hover and keyboard focus look the same: bright and bold */
    color: #ffffff !important;
    border: round #ffffff !important;
    text-style: bold !important;                             /* also removes Textual's default "bold reverse" on focus */
}
.mgr-actions Button.-active,
.dialog-buttons Button.-active,
.ask-buttons Button.-active,
.cfg-buttons Button.-active {                                /* the moment of the press */
    color: #ffffff !important;
    background: #3a3a3a !important;
    border: round #ffffff !important;
}
.mgr-actions Button:disabled,
.dialog-buttons Button:disabled,
.ask-buttons Button:disabled,
.cfg-buttons Button:disabled {                               /* no row selected, or Danica is busy */
    color: #6b6b6b !important;
    border: round #3a3a3a !important;
    opacity: 1 !important;                                   /* Textual would also fade it; the greys already say "off" */
    text-style: none !important;
}

/* ---- split screen: chat | subagent pane ---- */
#main { height: 1fr; }

#agents-pane {
    width: 45%;                 /* the chat keeps the other 55% */
    height: 100%;
    margin: 0 1 0 0;
    border: round #5c5c5c;
}

#sub-head { height: 1; padding: 0 1; }
#sub-log  { height: 1fr; padding: 0 1; background: transparent; scrollbar-size-vertical: 1; }
#sub-live { height: auto; max-height: 3; padding: 0 1; }

#agents-pane, #viewer-pane { border: round #4a4a4a; background: transparent; }

