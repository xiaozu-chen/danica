/* viewer.tcss - loaded AFTER app.tcss, so these rules win over the old #agents-pane rule */

/* the right-hand column holds the subagent pane and the file viewer (one or both, stacked) */
#side {
    width: 45%;                 /* the chat keeps the other 55% */
    height: 100%;
}

#agents-pane, #viewer-pane {
    width: 100%;
    height: 1fr;
    margin: 0 1 0 0;
    border: round #4a4a4a;
}

#view-head { height: 1; padding: 0 1; }
#view-scroll { height: 1fr; scrollbar-size-vertical: 1; scrollbar-color: #606060; }
#view-body { padding: 0 1; }
