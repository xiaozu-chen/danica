/* viewer.tcss - loaded AFTER app.tcss, so these rules win over the old #agents-pane rule */

/* the right-hand column holds the subagent pane and the file viewer (one or both, stacked) */
#side {
    width: 45%;                 /* the chat keeps the other 55% */
    height: 100%;
}

#agents-pane, #viewer-pane {
    width: 100%;
    height: 1fr;
    margin: 0 1 0 0;
    border: round #4a4a4a;
}

#view-head { height: 1; padding: 0 1; }
#view-scroll { height: 1fr; scrollbar-size-vertical: 1; scrollbar-color: #606060; }
#view-body { padding: 0 1; }

/* left-hand session list: the mirror image of #side */
#sessions-pane {
    width: 50;
    height: 100%;
    margin: 0 1 0 0;
    border: round #4a4a4a;
    background: transparent;
}

#sess-head { height: 1; padding: 0 1; }
#sess-scroll { height: 1fr; scrollbar-size-vertical: 1; scrollbar-color: #606060; }
#sess-body { padding: 0 1; }

/* top bar: [ sidebar ] | chat title | [ subagents ] [ file view ] [ artifacts ] */
#topbar {
    height: 2;                          /* one line of content + the divider below it */
    width: 100%;
    padding: 0 1;
    background: transparent;
    border-bottom: solid #404040;
    link-color: #ffffff;
    link-color-hover: #000000;
    link-background: transparent;
    link-background-hover: #ffffff;
    link-style: not underline;
    link-style-hover: bold not underline;
}
#tb-left, #tb-right { width: auto; height: 1; }
#tb-title { width: 1fr; height: 1; content-align: center middle; }

/* the sidebar menu above the session list */
#side-menu { height: auto; padding: 0 1; margin: 0 0 1 0; }

/* the artifacts pane in the right-hand column */
#artifacts-pane {
    width: 100%;
    height: 1fr;
    margin: 0 1 0 0;
    border: round #4a4a4a;
    background: transparent;
}
#art-head { height: 1; padding: 0 1; }
#art-scroll { height: 1fr; scrollbar-size-vertical: 1; scrollbar-color: #606060; }
#art-body { padding: 0 1; }
